# Copy to .env.local. Never put credentials in VITE_* variables (those reach the browser).
# Install Magpie separately; use its command on PATH or an absolute local executable path.
MAGPIE_BIN=magpie
MAGPIE_GATEWAY=http://127.0.0.1:3425/v1
# Local gateway placeholder only. Set your own key when your provider requires one.
MAGPIE_KEY=magpie
MAGPIE_VISION_MODEL=codex/gpt-6.1-terra
GAMEUI_DATA=.data
