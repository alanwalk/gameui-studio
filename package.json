{
  "name": "gameui-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cli": "node scripts/gameui.mjs",
    "check:cli": "node scripts/test-cli.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "check:integration": "node scripts/check.mjs --integration",
    "check:web": "node scripts/check.mjs --web",
    "check:model": "node scripts/check.mjs --model",
    "smoke": "esbuild scripts/smoke.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=warning && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  },
  "license": "MIT",
  "description": "GameUI Studio - local AI-assisted game UI authoring",
  "repository": {
    "type": "git",
    "url": "https://github.com/alanwalk/gameui-studio.git"
  }
}
